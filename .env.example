MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_FAST=nvidia/Nemotron-3_5-Lightning
MODEL_FAST_FALLBACK=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

