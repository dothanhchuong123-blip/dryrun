# Copy to .env (gitignored) and fill in. Never commit real keys.
NEBIUS_API_KEY=
TAVILY_API_KEY=

# Token Factory — IDs verified 2026-10-14 (case-sensitive)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_FAST=nvidia/Nemotron-3_5-Lightning
MODEL_FAST_FALLBACK=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Spend guards (USD, estimated from token usage)
DAILY_SPEND_CAP_USD=1.00
PUBLIC_LIVE_DAILY_CAP_USD=0.20
TAVILY_DAILY_CREDIT_CAP=30

# Serverless Job "mc-10k" (T09). JOB_BACKEND: empty = off, local = run in a subprocess, nebius = Nebius CLI
JOB_BACKEND=
JOB_DATA_DIR=/data
JOB_BUCKET=
JOB_IMAGE=
JOB_PLATFORM=cpu-d3
JOB_PRESET=4vcpu-16gb
